FROM node:22.13.0-bookworm-slim@sha256:f5a0871ab03b035c58bdb3007c3d177b001c2145c18e81817b71624dcf7d8bff AS ui
WORKDIR /build
COPY frontend ./frontend
RUN npm --prefix frontend ci --ignore-scripts --no-audit --no-fund && npm --prefix frontend run build

FROM nginx:1.28.0-alpine@sha256:30f1c0d78e0ad60901648be663a710bdadf19e4c10ac6782c235200619158284
RUN apk add --no-cache iptables
COPY --from=ui /build/frontend/dist /usr/share/nginx/html/app
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY docker/network_guard.sh /opt/network_guard.sh
USER 101:101
ENTRYPOINT ["nginx", "-g", "daemon off;"]
